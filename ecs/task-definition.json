{
  "family": "notification-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::581979856637:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::581979856637:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "notification-service",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "notification-service-8080",
          "appProtocol": "http"

        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notification-service",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "notification-service",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -q --spider http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 180
      }
    },
    {
      "name": "otel-collector",
      "image": "IMAGE_URI",
      "essential": true,
      "command": [
        "--config=/etc/ecs/otel-collector-config.yaml"
      ],
      "secrets": [
        {
          "name": "SPRING_PROMETHEUS_URL",
          "valueFrom": "arn:aws:ssm:us-east-2:581979856637:parameter/SPRING_PROMETHEUS_URL"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notification-otel-collector",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "otel-collector",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}